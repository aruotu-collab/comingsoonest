# Copy to .env.local and fill in real values. Never commit .env.local.

# Prisma Postgres (required)
DATABASE_URL=

# App URL (production: https://comingsoonest.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron / alert test auth
CRON_SECRET=

# Resend email (optional locally; required for real alerts)
RESEND_API_KEY=
RESEND_FROM=Coming Soonest <alerts@comingsoonest.com>

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML verification token (optional; domain verify uses DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
