# Copy to .env.local and fill in real values. Never commit .env.local.

# Prisma Postgres (required)
DATABASE_URL=

# App URL (production: https://comingsoonest.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron / alert test auth
CRON_SECRET=

# Resend email (optional locally; required for real alerts)
RESEND_API_KEY=
RESEND_FROM=Coming Soonest <alerts@comingsoonest.com>

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# YouTube Data API v3 (optional) — auto-find product videos on launch pages
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Extra admin emails (comma-separated). Default always includes aruotu@gmail.com
ADMIN_EMAILS=

# Google Search Console HTML verification token (optional; domain verify uses DNS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
